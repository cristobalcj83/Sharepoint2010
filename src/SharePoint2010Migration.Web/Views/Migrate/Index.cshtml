@model SharePoint2010Migration.Web.Models.MigrationRunRequest
@{
    ViewBag.Title = "SharePoint 2010 Document Migration";
    var result = ViewBag.Result as SharePoint2010Migration.Web.Models.MigrationRunResult;
}

<h2>SharePoint 2010 Document Migration</h2>

@using (Html.BeginForm("Run", "Migrate", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div>
        <label>Site URL</label><br />
        @Html.TextBoxFor(m => m.SiteUrl, new { style = "width: 480px" })
    </div>

    <div>
        <label>Library Title</label><br />
        @Html.TextBoxFor(m => m.LibraryTitle, new { style = "width: 480px" })
    </div>

    <div>
        <label>Domain</label><br />
        @Html.TextBoxFor(m => m.Domain, new { style = "width: 240px" })
    </div>

    <div>
        <label>User</label><br />
        @Html.TextBoxFor(m => m.UserName, new { style = "width: 240px" })
    </div>

    <div>
        <label>Password</label><br />
        @Html.PasswordFor(m => m.Password, new { style = "width: 240px" })
    </div>

    <div>
        <label>Modified Since (UTC)</label><br />
        @Html.TextBoxFor(m => m.ModifiedSinceUtc, "{0:yyyy-MM-ddTHH:mm:ss}", new { style = "width: 240px" })
    </div>

    <br />
    <button type="submit">Run Migration</button>
}

@if (result != null)
{
    <hr />
    <h3>Result</h3>
    <ul>
        <li>Processed: @result.ProcessedCount</li>
        <li>Inserted/Updated: @result.InsertedOrUpdatedCount</li>
        <li>Skipped non-PDF: @result.SkippedNonPdfCount</li>
        <li>Errors: @result.ErrorCount</li>
        <li>Last error: @result.LastError</li>
    </ul>
}
